# Copiá este fichero a .env.local y completalo. .env.local no se sube al repo.

# MongoDB local (docker compose up -d) o la cadena de Atlas en producción.
MONGODB_URI=mongodb://localhost:27017
# Nombre de la base. Si falta, el de la URI; si tampoco, "ecommerce".
MONGODB_DB=ecommerce

# Firma de las sesiones (JWT). Un texto largo al azar: openssl rand -base64 32
AUTH_SECRET=

# Stripe, en modo prueba (sandbox): dashboard.stripe.com → Desarrolladores → Claves de API.
STRIPE_SECRET_KEY=sk_test_...
# Local: lo imprime `stripe listen`. Producción: el del webhook creado en Stripe.
STRIPE_WEBHOOK_SECRET=whsec_...
# Opcional: la app no usa Stripe.js en el navegador (Checkout es una página de
# Stripe), pero el enunciado la lista.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Dominio público, para las URL de vuelta de Stripe. Local: no hace falta.
# APP_URL=https://casa-del-mate-santiago.onrender.com

# El admin que crea `npm run seed`.
ADMIN_EMAIL=admin@lamatera.test
ADMIN_PASSWORD=
ADMIN_NAME=Admin
